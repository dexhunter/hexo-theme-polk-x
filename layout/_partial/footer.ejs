<footer>
  <%= date(new Date(), 'YYYY') %>
  <span class="author">
    <%= config.author || '' %>
  </span>
</footer>

<%
  // Static bookworm cat: answers are built at generate time, no API calls.
  var posts = site.posts.sort('date', -1).toArray();
  var tagNames = site.tags.sort('length', -1).toArray().slice(0, 5).map(function(t) { return t.name; });
  var isPost = page.layout === 'post' && page.title;
  var summaryText = isPost
    ? truncate(strip_html(page.excerpt || page.content || ''), {length: 300})
    : '';
  var catData = {
    intro: config.title + ' — ' + (config.description || '') + '. ' +
      'Written by ' + (config.author || '') + ': book notes, reading lists and yearly reviews, in English and Chinese.',
    summary: isPost
      ? {title: page.title, text: summaryText}
      : {count: posts.length, tags: tagNames, latest: posts.slice(0, 3).map(function(p) { return {title: p.title, url: url_for(p.path)}; })},
    books: posts.map(function(p) { return {title: p.title, url: url_for(p.path)}; })
  };
%>
<div class="cat-assistant" id="cat-assistant">
  <div class="cat-panel" id="cat-panel" hidden>
    <div class="cat-messages" id="cat-messages">
      <div class="cat-msg cat-bot">I'm your bookworm servant, pick a question below</div>
    </div>
    <div class="cat-starters">
      <button type="button" data-q="intro">introduce the website</button>
      <button type="button" data-q="summary">summary</button>
      <button type="button" data-q="recommend">recommend a book</button>
    </div>
  </div>
  <button type="button" class="cat-toggle" id="cat-toggle" aria-label="Open bookworm cat">🐱</button>
</div>
<script>
(function () {
  var data = <%- JSON.stringify(catData).replace(/</g, '\\u003c') %>;
  var panel = document.getElementById('cat-panel');
  var messages = document.getElementById('cat-messages');

  function add(cls, text, link) {
    var el = document.createElement('div');
    el.className = 'cat-msg ' + cls;
    el.textContent = text;
    if (link) {
      var a = document.createElement('a');
      a.href = link.url;
      a.textContent = link.title;
      el.appendChild(document.createElement('br'));
      el.appendChild(a);
    }
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
  }

  var answers = {
    intro: function () { add('cat-bot', data.intro); },
    summary: function () {
      var s = data.summary;
      if (s.title) return add('cat-bot', '"' + s.title + '": ' + (s.text || 'No summary available.'));
      add('cat-bot', s.count + ' posts so far. Top tags: ' + s.tags.join(', ') + '. Latest:');
      s.latest.forEach(function (p) { add('cat-bot', '', p); });
    },
    recommend: function () {
      var b = data.books[Math.floor(Math.random() * data.books.length)];
      add('cat-bot', 'Try this one:', b);
    }
  };

  document.getElementById('cat-toggle').addEventListener('click', function () {
    panel.hidden = !panel.hidden;
  });
  panel.querySelectorAll('.cat-starters button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      add('cat-user', btn.textContent);
      answers[btn.dataset.q]();
    });
  });
})();
</script>
