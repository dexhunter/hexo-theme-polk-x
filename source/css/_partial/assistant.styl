.cat-assistant {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 13px;
}

.cat-toggle {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background-color: var(--background-color);
  font-size: 26px;
  cursor: pointer;
  transition: transform 0.3s ease;

  &:hover {
    transform: scale(1.1);
  }
}

.cat-panel {
  width: 300px;
  max-width: calc(100vw - 40px);
  margin-bottom: 10px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background-color: var(--background-color);
  color: var(--text-color);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);

  &[hidden] {
    display: none;
  }
}

.cat-messages {
  max-height: 320px;
  overflow-y: auto;
  padding: 12px;
}

.cat-msg {
  margin-bottom: 8px;
  padding: 6px 10px;
  border-radius: 6px;
  line-height: 1.5em;
  word-break: break-word;

  a {
    text-decoration: underline;
  }
}

.cat-bot {
  background-color: var(--code-background);
}

.cat-user {
  margin-left: 40px;
  text-align: right;
  color: var(--gray-color);
}

.cat-starters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 10px 12px;
  border-top: 1px solid var(--border-color);

  button {
    padding: 4px 10px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background-color: var(--background-color);
    color: var(--text-color);
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;

    &:hover {
      border-color: var(--gray-color);
    }
  }
}
